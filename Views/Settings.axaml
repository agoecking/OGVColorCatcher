<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:OGVColorCatcher.ViewModels"
		mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="450"
		Width="400" Height="250"
		x:Class="OGVColorCatcher.Settings"
		Icon="/Assets/Occ.ico"
		Title="Settings"
		CanResize="False"
		WindowStartupLocation="CenterOwner"
		Background="#C2C2C2">

	<StackPanel Margin="20" x:DataType="local:MainWindowViewModel">


		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<Label Grid.Row="0" Grid.Column="0" Content="Serial do aparelho:" VerticalAlignment="Center" Margin="3"/>
			<TextBox x:Name="SerialTextBox" Grid.Row="0" Grid.Column="1" FontSize="15" Margin="3" MinWidth="200"/>
			<Button Grid.Row="1" Grid.Column="1" Content="Save" Command="{Binding SaveDeviceSerialCommand}" CommandParameter="{Binding Text, ElementName=SerialTextBox}" Margin="3,12,0,0"/>

		</Grid>
	</StackPanel>
</Window>

<!--status
substrato
numero de casas decimais
escolha de porcentagem para dot gain
escolha de porcentagem para dot curve-->