<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OGVColorCatcher.Popup"
        Icon="/Assets/Occ.ico"
        Width="340" Height="140"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent">
  <Border Background="White" CornerRadius="8" Padding="12" Margin="8">
    <StackPanel Spacing="12">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14"/>
      <Button HorizontalAlignment="Right" Content="OK" Click="Ok_Click"/>
    </StackPanel>
  </Border>
</Window>