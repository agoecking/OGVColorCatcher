<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:OGVColorCatcher.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="OGVColorCatcher.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Icon="/Assets/avalonia-logo.ico"
		Title="OGVColorCatcher"
		xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
		Width="620" Height="660"
		MinWidth="620" MinHeight="660"
		Background="#ECECEC">
	<Window.Styles>
		<Style Selector="GroupBox">
			<Setter Property="BorderThickness" Value="2"/>
		</Style>
	</Window.Styles>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>

		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="2*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--HEADER-->
		<Border Grid.Row="0" Background="#C2C2C2" Grid.ColumnSpan="3" Grid.Column="0" Padding="15">
			<Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto">

				<Label Content="Device:" Grid.Column="0" Foreground="Black" Grid.Row="0" VerticalAlignment="Center" Margin="5"/>

				<ComboBox Grid.Column="1"
						  Width="120"
						  Margin="5"
						  ItemsSource="{Binding Devices}"
						  SelectedItem="{Binding CurrentDevice, Mode=TwoWay}">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<!-- GRID DOS BOTÕES -->
				<Grid Grid.Column="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- Botão Desconectar -->
					<Button Grid.Column="0"
							Margin="10,5,0,5"
							Command="{Binding CloseDeviceCommand}"
							ToolTip.Tip="Desconectar"
							Background="Transparent"
							IsEnabled="False"
							BorderThickness="0"
							Foreground="Black">
						<Viewbox Width="20" Height="20">
							<Canvas Width="24" Height="24">
								<Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
									  StrokeThickness="1" Fill="Transparent"
									  Data="M6,14 L12,8 L14,10 L8,16 Z"/>
								<Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
									  StrokeThickness="1" Data="M12,6 L12,3"/>
								<Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
									  StrokeThickness="1" Data="M15,7 L15,4"/>
								<Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
									  StrokeThickness="1" Data="M5,17 C8,20 14,20 17,17"/>
								<Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
									  StrokeThickness="1" Data="M4,4 L20,20"/>
							</Canvas>
						</Viewbox>
					</Button>

					<!-- Botão Calibrar -->
					<Button Grid.Column="1"
							Content="Calibrar"
							Background="DarkGray"
							Margin="10,0,0,0"
							Command="{Binding CalibrateCommand}"/>

					<!--					--><!-- Botão Substrate --><!--
					<Button Grid.Column="2"
					Content="Substrate"
					Margin="10,0,0,0"
					FontSize="11"
					IsEnabled="{Binding EnableSubstrateButton}"
					HorizontalContentAlignment="Center"
					Command="{Binding Substrate}"/>-->

					<Button Grid.Column="3"
							Click="OpenSettings"
							Width="30"
							Height="30"
							IsEnabled="{Binding settingsEnabled}"
							Background="Transparent"
							BorderThickness="0"
							HorizontalAlignment="Right"
							Margin="5">
						<Path Stretch="UniformToFill"
							  Fill="Black"
							  Width="20"
							  HorizontalAlignment="Center"
							  Height="20"
							  Data="M19.14,12.94 C19.19,12.64 19.22,12.32 19.22,12 C19.22,11.68 19.19,11.36 19.14,11.06 L21.19,9.47 C21.33,9.36 21.38,9.15 21.31,8.97 L19.31,4.97 C19.22,4.77 19,4.68 18.81,4.73 L16.37,5.35 C15.87,4.96 15.31,4.62 14.69,4.34 L14.3,1.72 C14.27,1.5 14.09,1.34 13.87,1.34 H10.13 C9.91,1.34 9.73,1.5 9.7,1.72 L9.31,4.34 C8.69,4.62 8.13,4.96 7.63,5.35 L5.19,4.73 C5,4.68 4.78,4.77 4.69,4.97 L2.69,8.97 C2.61,9.15 2.67,9.36 2.81,9.47 L4.86,11.06 C4.81,11.36 4.78,11.68 4.78,12 C4.78,12.32 4.81,12.64 4.86,12.94 L2.81,14.53 C2.67,14.64 2.61,14.85 2.69,15.03 L4.69,19.03 C4.78,19.23 5,19.32 5.19,19.27 L7.63,18.65 C8.13,19.04 8.69,19.38 9.31,19.66 L9.7,22.28 C9.73,22.5 9.91,22.66 10.13,22.66 H13.87 C14.09,22.66 14.27,22.5 14.3,22.28 L14.69,19.66 C15.31,19.38 15.87,19.04 16.37,18.65 L18.81,19.27 C19,19.32 19.22,19.23 19.31,19.03 L21.31,15.03 C21.38,14.85 21.33,14.64 21.19,14.53 L19.14,12.94 Z M12,15.5 C10.07,15.5 8.5,13.93 8.5,12 C8.5,10.07 10.07,8.5 12,8.5 C13.93,8.5 15.5,10.07 15.5,12 C15.5,13.93 13.93,15.5 12,15.5 Z" />
					</Button>

					<!--					<ItemsControl ItemsSource="{Binding RibbonRowsSubstrate[0].Colors}"
					Grid.Column="4"
					Margin="10,0,0,0"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
					<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal"/>
					</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
					<DataTemplate>
					<Border Width="25"
					Height="25"
					Background="{Binding}"
					BorderBrush="Black"
					BorderThickness="1"
					Margin="0"/>
					</DataTemplate>
					</ItemsControl.ItemTemplate>
					</ItemsControl>-->
					<!--					<TextBlock Text="{Binding ShowMessage}"
					Grid.Column="5"
					Margin="0"
					TextElement.Foreground="DarkRed"
					FontSize="13"
					HorizontalAlignment="Center"
					Height="20"/>-->

					<TextBlock Text="Senha:"
							   Grid.Column="6"
							   Margin="0,0,5,0"
							   TextElement.Foreground="DarkRed"
							   FontSize="13"
							   HorizontalAlignment="Center"
							   Height="20"/>

					<TextBox x:Name="passwordBox" Margin="5"
							 Grid.Column="7"
							 MinWidth="98"
							 MaxLength="9"
							 IsEnabled="True"/>

					<Button Grid.Column="8"
							Content="Enviar"
							Command="{Binding SubmitPasswordCommand}"
							CommandParameter="{Binding Text, ElementName=passwordBox}"
							Margin="5"/>
				</Grid>


			</Grid>
		</Border>
		<!--		<StackPanel Grid.Column="2" Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Right">
		<Grid>
		<Grid.ColumnDefinitions>
		<ColumnDefinition Width="Auto"/>
		<ColumnDefinition Width="Auto"/>
		<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>
		<TextBlock Grid.Column="0"
		FontSize="12"
		Margin="0,0,20,0"
		Text="{Binding PaperSelected}"/>
		<TextBlock Grid.Column="1"
		FontSize="12"
		Margin="0,0,20,0"
		Text="{Binding StatusSelected}"/>
		<TextBlock Grid.Column="2"
		FontSize="12"
		Margin="0,0,20,0"
		Text="{Binding CalibrationElapsedTime}"
		/>
		</Grid>


		</StackPanel>-->

		<!-- CORPO -->
		<Grid Grid.Row="1"
			  Margin="12"
			  ColumnDefinitions="1*,1*"
			  RowDefinitions="1.2*,1*,Auto"
			  ColumnSpacing="14"
			  RowSpacing="14">

			<GroupBox Grid.Row="0" Grid.Column="0" Header="Configurações de leitura" >
				<StackPanel Margin="12" Spacing="8">
					<ComboBox SelectedIndex="0">
						<ComboBoxItem Content="A"/>
					</ComboBox>

					<CheckBox Content="Density" IsChecked="True"/>
					<CheckBox Content="LAB" IsChecked="True"/>
					<CheckBox Content="Spectrum" IsChecked="True"/>

					<TextBlock Text="M0/M1/M2:" Margin="0,4,0,0"/>

					<ComboBox SelectedIndex="0">
						<ComboBoxItem Content="M0"/>
					</ComboBox>
					<ComboBox SelectedIndex="0">
						<ComboBoxItem Content="M1"/>
					</ComboBox>
					<ComboBox SelectedIndex="0">
						<ComboBoxItem Content="M2"/>
					</ComboBox>
				</StackPanel>
			</GroupBox>

			<GroupBox Grid.Row="0" Grid.Column="1" Header="Configurações de escrita">
				<StackPanel Margin="12" Spacing="8">
					<ComboBox SelectedIndex="0">
						<ComboBoxItem Content="Ponto"/>
					</ComboBox>

					<Border Background="#EFEFEF" Padding="10" Margin="0,6,0,0">
						<StackPanel Spacing="6">
							<CheckBox Content="Mostrar Status (AEIT)" IsChecked="True"/>
							<CheckBox Content="Mostrar M0/M1/M2" IsChecked="True"/>
							<CheckBox Content="Enter adicional" IsChecked="False"/>
						</StackPanel>
					</Border>

					<Border Background="#EFEFEF" Padding="10">
						<StackPanel Spacing="6">
							<CheckBox Content="Lembrar" IsChecked="False"/>
							<CheckBox Content="Dados na mesma linha" IsChecked="False"/>
							<CheckBox Content="Leituras na mesma linha" IsChecked="False"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</GroupBox>

			<GroupBox Grid.Row="1" Grid.Column="0" Header="Média">
				<StackPanel Margin="12" Spacing="10">
					<TextBlock Text="Número de média"/>

					<StackPanel Orientation="Horizontal" Spacing="6">
						<Button Content="-" Width="30"/>
						<TextBox Text="1" Width="50" HorizontalContentAlignment="Center"/>
						<Button Content="+" Width="30"/>
					</StackPanel>

					<CheckBox Content="Mostrar leituras (média)" IsChecked="True"/>
				</StackPanel>
			</GroupBox>

			<GroupBox Grid.Row="1" Grid.Column="1" Header="Salvar em arquivo">
				<StackPanel Margin="12" Spacing="10">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<CheckBox Content="Salvar em arquivo TXT" IsChecked="False"/>
						<Button Content="Escolher Pasta" IsEnabled="False"/>
					</StackPanel>

					<CheckBox Content="Cabeçalho" IsChecked="False"/>
					<TextBlock Text="Modo: Teclado (padrão)" Foreground="Gray"/>
				</StackPanel>
			</GroupBox>
		</Grid>
	</Grid>

</Window>
