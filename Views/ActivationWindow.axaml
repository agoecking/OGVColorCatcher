<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OGVColorCatcher.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="450"
        d:DesignHeight="450"
        Width="400"
        Height="250"
        x:Class="OGVColorCatcher.ActivationWindow"
        Title="Settings"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#C2C2C2">

    <StackPanel Margin="20" x:DataType="local:MainWindowViewModel">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Text="Digite sua chave de ativação:"
                FontSize="14"
                Margin="0,0,0,10"/>

            <TextBox
                x:Name="LicenseKey"
                Grid.Row="1"
                Height="28"
                Margin="0,0,0,12"/>

            <Button
                Grid.Row="2"
                Content="Ativar"
                Height="32"
                Width="120"
                HorizontalAlignment="Left"
                Command="{Binding SubmitActivationCommand}"
                CommandParameter="{Binding Text, ElementName=LicenseKey}"/>

            <TextBlock Text="{Binding ShowError}"
                       Margin="6, 35,0,0"
                       Grid.Row="3"
                       TextElement.Foreground="DarkRed"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Height="20"/>

        </Grid>

    </StackPanel>
</Window>